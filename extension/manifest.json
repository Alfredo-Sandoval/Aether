{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.7.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": [
        "content/targeting-phrases.js",
        "content/shared-utils.js",
        "content/runtime-client.js",
        "content/i18n-loader.js",
        "content/sidebar-tools.js",
        "content/research-tools.js",
        "content/background-media.js",
        "content/surface-tagging.js",
        "content/welcome-screen.js",
        "content/settings-controls.js",
        "content/quick-settings.js",
        "content/content.js"
      ],
      "css": ["styles/styles.css", "styles/sidebar.css", "styles/quick-settings.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/backgrounds/blue-galaxy.webp",
        "assets/backgrounds/cosmic-purple.webp",
        "assets/backgrounds/deep-space-nebula.webp",
        "assets/backgrounds/milky-way-galaxy.webp",
        "assets/backgrounds/nebula-purple-blue.webp",
        "assets/backgrounds/space-stars-purple.webp",
        "assets/backgrounds/space-orion-nebula-nasa.webp",
        "assets/backgrounds/space-pillars-creation-jwst.webp",
        "assets/backgrounds/space-milkyway-blue-pexels.webp",
        "assets/backgrounds/space-milkyway-ridge-pexels.webp",
        "assets/backgrounds/space-purple-nebula-unsplash.webp",
        "assets/backgrounds/space-purple-stars-pexels.webp",
        "assets/backgrounds/aurora-classic.webp",
        "assets/backgrounds/obsidian-bloom.webp",
        "assets/backgrounds/liquid-sapphire.webp",
        "assets/backgrounds/velvet-dusk.webp",
        "assets/backgrounds/arctic-glass.webp",
        "assets/backgrounds/neural-field.webp",
        "assets/backgrounds/topographic-mist.webp",
        "assets/backgrounds/infrared-noir.webp",
        "assets/backgrounds/emerald-drift.webp",
        "assets/thumbnails/*.webp",
        "_locales/*/messages.json"
      ],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ]
}
